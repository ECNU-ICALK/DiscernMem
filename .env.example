# OpenAI-compatible chat endpoint used by the MAS agents and DiscernMem.
LLM_API_KEY=EMPTY
LLM_BASE_URL=http://127.0.0.1:8100/v1
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507

# OpenAI-compatible embedding endpoint used by DiscernMem retrieval.
DISCERNMEM_EMBED_API_KEY=EMPTY
DISCERNMEM_EMBED_BASE_URL=http://127.0.0.1:8002/v1
DISCERNMEM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# Optional: retrieval endpoint for TriviaQA and PopQA (default http://127.0.0.1:8000/retrieve).
# SEARCH_URL=http://127.0.0.1:8000/retrieve
