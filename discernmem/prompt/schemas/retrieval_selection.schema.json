{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "selected_ids"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["SELECT", "NONE"]
    },
    "selected_ids": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 3,
      "uniqueItems": true
    }
  }
}
