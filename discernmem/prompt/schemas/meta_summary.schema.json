{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "use_when",
    "avoid_when"
  ],
  "properties": {
    "use_when": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "avoid_when": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
